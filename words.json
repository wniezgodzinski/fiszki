  {"id": "h001", "es": "tus", "pl": "twoi / twoje (l.mn.)", "ex": "¿Dónde están tus padres? – Gdzie są twoi rodzice?", "tags": ["zaimki", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h002", "es": "su", "pl": "jego / jej / ich (l.poj.)", "ex": "Su nombre es David. – Jego imię to Dawid. · Su hijo es muy listo. – Ich syn jest bardzo bystry.", "tags": ["zaimki", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h003", "es": "sus", "pl": "jego / jej / ich (l.mn.)", "ex": "Sus perros son muy tranquilos. – Jego psy są bardzo spokojne. · Sus gatos son chulos. – Ich koty są urocze.", "tags": ["zaimki", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h004", "es": "nuestro", "pl": "nasz", "ex": "Nuestro coche es muy viejo. – Nasz samochód jest bardzo stary.", "tags": ["zaimki", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h005", "es": "nuestros", "pl": "nasi / nasze (l.mn.)", "ex": "Nuestros hijos son adultos. – Nasze dzieci są dorosłe.", "tags": ["zaimki", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h006", "es": "vuestro", "pl": "wasz", "ex": "Vuestra casa es cómoda. – Wasz dom jest wygodny.", "tags": ["zaimki", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h007", "es": "vuestros", "pl": "wasi / wasze (l.mn.)", "ex": "Vuestras ideas son estupendas. – Wasze pomysły są doskonałe.", "tags": ["zaimki", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h008", "es": "esto", "pl": "to (to tutaj)", "ex": "¿Qué es esto? – Co to jest?", "tags": ["zaimki", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h009", "es": "querer", "pl": "chcieć; kochać", "ex": "¿Qué quieres? – Czego chcesz?", "tags": ["czasowniki", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h010", "es": "el problema", "pl": "problem", "ex": "Tengo un problema. – Mam problem. (uwaga: el problema – rodzaj męski)", "tags": ["dom i codzienność", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h011", "es": "la radio", "pl": "radio", "ex": "Apaga la radio. – Wyłącz radio.", "tags": ["dom i codzienność", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h012", "es": "¿Cómo?", "pl": "Jak? / Jaki? Jaka?", "ex": "¿Cómo puedo llegar al centro de la ciudad? – Jak mogę dostać się do centrum? · ¿Cómo es él? – Jaki on jest?", "tags": ["pytania", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h013", "es": "¿De quién?", "pl": "Czyj?", "ex": "¿De quién es esto? – Czyje to jest?", "tags": ["pytania", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h014", "es": "¿Cuál?", "pl": "Który?", "ex": "¿Cuáles son nuestros asientos? – Które miejsca są nasze?", "tags": ["pytania", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h015", "es": "la pregunta", "pl": "pytanie", "ex": "Tengo una pregunta. – Mam pytanie.", "tags": ["pytania", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h016", "es": "la respuesta", "pl": "odpowiedź", "ex": "No hay una respuesta sencilla. – Nie ma łatwej odpowiedzi.", "tags": ["pytania", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
  {"id": "h017", "es": "¡Buenos días!", "pl": "Dzień dobry! (rano)", "ex": "", "tags": ["zwroty grzecznościowe", "Hiszpański w 1 dzień"], "lesson": "2026-11-21"},
